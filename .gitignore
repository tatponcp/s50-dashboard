# ไฟล์ชั่วคราวของ Python
__pycache__/
.venv/
# pip ในเครื่องนี้ prefix เพี้ยน อาจเผลอสร้าง Lib/Scripts ที่ root โปรเจกต์ — กันไว้
# ("/" นำหน้า = anchor ที่ root เท่านั้น ไม่งั้นจะไปบัง src/lib/ ของแอปอื่นด้วย
# เพราะ Windows จับคู่ .gitignore แบบไม่สนตัวพิมพ์เล็ก-ใหญ่)
/Lib/
/Scripts/

# ไฟล์ session ของเครื่องมือช่วยเขียนโค้ด
.claude/

# ความลับ Supabase (service_role key) — ห้ามขึ้น repo เด็ดขาด
.env.local

# โฟลเดอร์ของ Vercel CLI (สร้างตอนรัน `vercel` ในเครื่อง)
.vercel/
